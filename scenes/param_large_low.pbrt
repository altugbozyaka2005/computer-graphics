# Module 2, 2.2.4: BF 32, MD 2: the overcast sky is the only light and is found only by the hemisphere rays;
# the open court returns little light, so two levels hold 99 % of it, but each level needs many rays.
LookAt 1.2 2.3 -5.6   0 1 1.8   0 1 0
Camera "perspective" "float fov" [ 48 ]
Film "rgb" "integer xresolution" [ 800 ] "integer yresolution" [ 600 ]
    "string filename" [ "param_large_low.png" ] "string tonemap" "reinhard"
Sampler "stratified" "integer xsamples" [ 2 ] "integer ysamples" [ 2 ] "bool jitter" true
Integrator "distributed" "integer maxdepth" [ 2 ] "integer branchingfactor" [ 32 ] "integer lightsamples" [ 1 ]

Include "include/m2_sculpture.pbrt"
