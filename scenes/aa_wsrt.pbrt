# Module 2, 2.2.2: aliasing in the WSRT. One ray through each pixel centre: the fence, wires,
# spokes and the checker lawn are sampled below their Nyquist rate.
LookAt 0 1.3 -3   0 1.2 10   0 1 0
Camera "perspective" "float fov" [ 48 ]
Film "rgb" "integer xresolution" [ 800 ] "integer yresolution" [ 600 ]
    "string filename" [ "aa_wsrt.png" ]
Sampler "independent" "integer pixelsamples" [ 1 ]
Integrator "whitted" "integer maxdepth" [ 3 ] "rgb ambient" [ 0.12 0.12 0.14 ]

Include "include/m2_garden.pbrt"
