# Module 3, 2.3.1 complex scene: a library reading room at dusk, 1617 objects (Shape directives;
# about 1,300 books, the herringbone parquet of 4920 planks as 5 meshes) and 11 area lights
# (4 banker's lamps, 4 pendants, 3 windows), rendered with the DRT.
LookAt 8.6 2.5 -1.5   -3.2 0.85 8.6   0 1 0
Camera "perspective" "float fov" [ 52 ] "float lensradius" [ 0.02 ] "float focaldistance" [ 8.3 ]
Film "rgb" "integer xresolution" [ 1920 ] "integer yresolution" [ 1280 ] "float exposure" [ 1.6 ]
    "string filename" [ "acc_complex.png" ]
Sampler "independent" "integer pixelsamples" [ 256 ]
Integrator "distributed" "integer maxdepth" [ 3 ] "integer lightsamples" [ 1 ]
Accelerator "bvh" "string splitmethod" "sah" "integer maxnodeprims" [ 4 ]

Include "include/m3_library.pbrt"
