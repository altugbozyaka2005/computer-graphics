# Ceiling spots and wall lamps for the DRT: small emissive shapes with "samples 0":
# visible-only emitters (seen directly and in mirrors/glass, they do not light the scene).
# Their illumination would be < 0.1 % of the key light; as real lights they cost half of all
# shadow rays, and as unsampled lights they caused speckles on the dark walls.
AttributeBegin Translate 10 69.9 320.7 Rotate 90 1 0 0 NamedMaterial "spot"
  AreaLightSource "diffuse" "blackbody L" [ 3500 ] "float scale" [ 40 ] "integer samples" [ 0 ]
  Shape "disk" "float radius" [ 1.6 ]
AttributeEnd
AttributeBegin Translate 35.2 69.9 339.3 Rotate 90 1 0 0 NamedMaterial "spot"
  AreaLightSource "diffuse" "blackbody L" [ 3500 ] "float scale" [ 40 ] "integer samples" [ 0 ]
  Shape "disk" "float radius" [ 1.6 ]
AttributeEnd
