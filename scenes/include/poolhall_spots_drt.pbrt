# Ceiling spots for the DRT: small emissive discs. "samples 0": visible and emitting, but
# not sampled with shadow rays (they add < 0.1 % of the light; sampling them cost half of
# all shadow rays). Their light still reaches the scene through paths that hit them.
AttributeBegin Translate 10 69.9 320.7 Rotate 90 1 0 0 NamedMaterial "spot"
  AreaLightSource "diffuse" "blackbody L" [ 3500 ] "float scale" [ 40 ] "integer samples" [ 0 ]
  Shape "disk" "float radius" [ 1.6 ]
AttributeEnd
