# Module 2, 2.2.2: supersampling with 4 sample(s) per pixel (2x2 jittered strata), averaged with equal weights.
LookAt 0 1.3 -3   0 1.2 10   0 1 0
Camera "perspective" "float fov" [ 48 ]
Film "rgb" "integer xresolution" [ 800 ] "integer yresolution" [ 600 ]
    "string filename" [ "aa_ss4.png" ]
Sampler "stratified" "integer xsamples" [ 2 ] "integer ysamples" [ 2 ] "bool jitter" true
Integrator "whitted" "integer maxdepth" [ 3 ] "rgb ambient" [ 0.12 0.12 0.14 ]

Include "include/m2_garden.pbrt"
