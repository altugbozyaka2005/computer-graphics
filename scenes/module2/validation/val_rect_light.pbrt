# Module 2 validation: area-light sample patterns against an analytic value. A 1 x 1 pixel camera looks at
# the floor point P = (0.3, 0, -0.2) under a 2 x 2 emitter (L = 1) at height 1.5; the floor is white (rho = 1),
# so the pixel value is the form factor from P to the rectangle (sum of four corner-rectangle terms).
LookAt 4 3 -2   0.3 0 -0.2   0 1 0
Camera "perspective" "float fov" [ 1 ]
Film "rgb" "integer xresolution" [ 1 ] "integer yresolution" [ 1 ] "string filename" [ "val_rect_light.pfm" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 1 ]
Integrator "distributed" "integer maxdepth" [ 1 ] "integer lightsamples" [ 16 ]
WorldBegin
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 1 1 1 ]
  Shape "trianglemesh" "point3 P" [ -1 1.5 -1   1 1.5 -1   1 1.5 1   -1 1.5 1 ] "integer indices" [ 0 1 2  0 2 3 ]
AttributeEnd
Material "diffuse" "rgb reflectance" [ 1 1 1 ]
Shape "trianglemesh" "point3 P" [ -20 0 -20  20 0 -20  20 0 20  -20 0 20 ] "integer indices" [ 0 1 2 0 2 3 ]
