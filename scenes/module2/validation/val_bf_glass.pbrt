# Module 2 validation: splitting at a dielectric (BF >= 2 traces reflection and refraction, weighted by
# Fresnel) must give the same image as the stochastic choice of BF = 1 (probability F of reflecting).
LookAt 0 1.2 -5  0 0.9 0  0 1 0
Camera "perspective" "float fov" [ 40 ]
Film "rgb" "integer xresolution" [ 160 ] "integer yresolution" [ 120 ] "string filename" [ "val_bf_glass.pfm" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 64 ]
Integrator "distributed" "integer maxdepth" [ 8 ] "integer lightsamples" [ 4 ]
WorldBegin
AttributeBegin AreaLightSource "diffuse" "rgb L" [ 4 4 4 ]
  Shape "trianglemesh" "point3 P" [ -1 3 -1  1 3 -1  1 3 1  -1 3 1 ] "integer indices" [ 0 1 2 0 2 3 ] AttributeEnd
Texture "chk" "spectrum" "checkerboard" "float uscale" [ 8 ] "float vscale" [ 8 ] "rgb tex1" [ 0.8 0.2 0.2 ] "rgb tex2" [ 0.9 0.9 0.9 ]
Material "diffuse" "texture reflectance" "chk"
Shape "trianglemesh" "point3 P" [ -4 0 -4  4 0 -4  4 0 4  -4 0 4 ] "integer indices" [ 0 1 2 0 2 3 ] "point2 uv" [ 0 0 1 0 1 1 0 1 ]
Shape "trianglemesh" "point3 P" [ -4 0 3  4 0 3  4 4 3  -4 4 3 ] "integer indices" [ 0 1 2 0 2 3 ] "point2 uv" [ 0 0 1 0 1 1 0 1 ]
AttributeBegin Translate 0 0.9 0 Material "dielectric" "float eta" [ 1.5 ] Shape "sphere" "float radius" [ 0.9 ] AttributeEnd
