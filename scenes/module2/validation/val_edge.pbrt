# Module 2 validation: supersampling against the exact pixel coverage. An emissive half-plane (L = 1)
# bounded by the line through (0, 10) and (64, 50.3) is seen by an orthographic camera whose screen window
# equals the 64 x 64 pixel grid, so the exact value of every pixel is the area of its square on the bright
# side. validate_module2.py renders it with each pixel sampler and 1 ... 256 samples per pixel.
LookAt 0 0 -1  0 0 0  0 1 0
Camera "orthographic" "float screenwindow" [ 0 64 0 64 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ] "string filename" [ "val_edge.png" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 1 ]
Integrator "whitted" "integer maxdepth" [ 1 ]
WorldBegin
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 1 1 1 ] "bool twosided" true
  Shape "trianglemesh" "point3 P" [ -6400 -4020 0   6464 4080.3 0   0 9000 0 ] "integer indices" [ 0 1 2 ]
AttributeEnd
