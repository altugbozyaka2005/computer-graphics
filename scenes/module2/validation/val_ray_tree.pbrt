# Module 2 validation: the DRT ray tree. Inside a closed diffuse box every ray hits a wall, so with
# branching factor BF the renderer must trace exactly BF^d rays per camera ray at depth d < maxdepth
# (the last level only returns environment light, of which there is none, and is not traced).
LookAt 0 1 -0.9  0 1 1  0 1 0
Camera "perspective" "float fov" [ 60 ]
Film "rgb" "integer xresolution" [ 40 ] "integer yresolution" [ 30 ] "string filename" [ "val_ray_tree.pfm" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 2 ]
Integrator "distributed" "integer maxdepth" [ 5 ] "integer branchingfactor" [ 3 ] "integer lightsamples" [ 1 ]
WorldBegin
LightSource "point" "point3 from" [ 0 1.8 0 ] "rgb I" [ 2 2 2 ]
Material "diffuse" "rgb reflectance" [ 0.6 0.6 0.6 ]
Shape "trianglemesh" "point3 P" [ -1 0 -1  1 0 -1  1 0 1  -1 0 1   -1 2 -1  1 2 -1  1 2 1  -1 2 1 ]
    "integer indices" [ 0 1 2  0 2 3   4 6 5  4 7 6   0 4 5  0 5 1   1 5 6  1 6 2   2 6 7  2 7 3   3 7 4  3 4 0 ]
