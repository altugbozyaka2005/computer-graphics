# Module 2 validation: the scene of val_ortho_size.pbrt through a perspective camera (fov 90, so that both spheres are in view).
LookAt 0 0 -10  0 0 0  0 1 0
Camera "perspective" "float fov" [ 90 ]
Film "rgb" "integer xresolution" [ 320 ] "integer yresolution" [ 240 ] "string filename" [ "val_ortho_size_persp.png" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 1 ]
Integrator "whitted" "integer maxdepth" [ 1 ] "rgb ambient" [ 0 0 0 ]
WorldBegin
LightSource "distant" "point3 from" [ 0 0 -1 ] "point3 to" [ 0 0 0 ] "rgb L" [ 1 1 1 ]
Material "blinnphong" "rgb Kd" [ 0.8 0.8 0.8 ]
AttributeBegin Translate -2 0 -8 Shape "sphere" "float radius" [ 1 ] AttributeEnd
AttributeBegin Translate 2 0 2 Shape "sphere" "float radius" [ 1 ] AttributeEnd
