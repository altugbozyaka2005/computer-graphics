# Module 2, 2.2.4 sweep for param_small_high: BF 4, MD 6, 16 samples per pixel (study resolution).
LookAt 2 1.65 -2.2   -3 1.35 0.9   0 1 0
Camera "perspective" "float fov" [ 50 ]
Film "rgb" "integer xresolution" [ 400 ] "integer yresolution" [ 300 ]
    "string filename" [ "mirrors_bf4_md6.png" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 16 ]
Integrator "distributed" "integer maxdepth" [ 6 ] "integer branchingfactor" [ 4 ] "integer lightsamples" [ 1 ]

Include "../../include/m2_mirrors.pbrt"
