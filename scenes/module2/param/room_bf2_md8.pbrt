# Module 2, 2.2.4 sweep for param_large_high: BF 2, MD 8, 4 samples per pixel (study resolution).
LookAt 0.2 1.55 -3.7   -0.1 1.15 1.8   0 1 0
Camera "perspective" "float fov" [ 62 ]
Film "rgb" "integer xresolution" [ 320 ] "integer yresolution" [ 240 ]
    "string filename" [ "room_bf2_md8.png" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 4 ]
Integrator "distributed" "integer maxdepth" [ 8 ] "integer branchingfactor" [ 2 ] "integer lightsamples" [ 1 ]

Include "../../include/m2_room.pbrt"
