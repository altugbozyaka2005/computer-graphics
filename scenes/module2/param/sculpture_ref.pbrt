# Module 2, 2.2.4: converged reference for param_large_low (BF 1, MD 6, 4096 samples per pixel).
LookAt 1.2 2.3 -5.6   0 1 1.8   0 1 0
Camera "perspective" "float fov" [ 48 ]
Film "rgb" "integer xresolution" [ 400 ] "integer yresolution" [ 300 ]
    "string filename" [ "sculpture_ref.png" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 4096 ]
Integrator "distributed" "integer maxdepth" [ 6 ] "integer branchingfactor" [ 1 ] "integer lightsamples" [ 1 ]

Include "../../include/m2_sculpture.pbrt"
