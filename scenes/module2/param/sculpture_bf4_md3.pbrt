# Module 2, 2.2.4 sweep for param_large_low: BF 4, MD 3, 4 samples per pixel (study resolution).
LookAt 1.2 2.3 -5.6   0 1 1.8   0 1 0
Camera "perspective" "float fov" [ 48 ]
Film "rgb" "integer xresolution" [ 400 ] "integer yresolution" [ 300 ]
    "string filename" [ "sculpture_bf4_md3.png" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 4 ]
Integrator "distributed" "integer maxdepth" [ 3 ] "integer branchingfactor" [ 4 ] "integer lightsamples" [ 1 ]

Include "../../include/m2_sculpture.pbrt"
