# Module 2, 2.2.4: converged reference for param_small_low (BF 1, MD 10, 2048 samples per pixel).
LookAt 3.6 4.6 -7.8   0.4 0.5 0.6   0 1 0
Camera "perspective" "float fov" [ 38 ]
Film "rgb" "integer xresolution" [ 400 ] "integer yresolution" [ 300 ]
    "string filename" [ "chess_ref.png" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 2048 ]
Integrator "distributed" "integer maxdepth" [ 10 ] "integer branchingfactor" [ 1 ] "integer lightsamples" [ 1 ]

Include "../../include/m2_chess.pbrt"
