# Module 2, 2.2.4: converged reference for param_small_high (BF 1, MD 48, 256 samples per pixel).
LookAt 2 1.65 -2.2   -3 1.35 0.9   0 1 0
Camera "perspective" "float fov" [ 50 ]
Film "rgb" "integer xresolution" [ 400 ] "integer yresolution" [ 300 ]
    "string filename" [ "mirrors_ref.png" ] "string tonemap" "none"
Sampler "independent" "integer pixelsamples" [ 256 ]
Integrator "distributed" "integer maxdepth" [ 48 ] "integer branchingfactor" [ 1 ] "integer lightsamples" [ 1 ]

Include "../../include/m2_mirrors.pbrt"
