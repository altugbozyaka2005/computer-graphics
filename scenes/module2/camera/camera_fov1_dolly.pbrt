# Module 2, 2.2.1: field of view 25 degrees with the camera moved along the view axis so that the
# red reference sphere keeps its size from the 60-degree view (dolly zoom).
LookAt 0 2.723 -22.0426   0 0.9 4   0 1 0
Camera "perspective" "float fov" [ 25 ]
Film "rgb" "integer xresolution" [ 800 ] "integer yresolution" [ 600 ]
    "string filename" [ "camera_fov1_dolly.png" ]
Sampler "stratified" "integer xsamples" [ 3 ] "integer ysamples" [ 3 ] "bool jitter" true
Integrator "whitted" "integer maxdepth" [ 2 ] "rgb ambient" [ 0.12 0.12 0.14 ]

Include "../../include/m2_gallery.pbrt"
