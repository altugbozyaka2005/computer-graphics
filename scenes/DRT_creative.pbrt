# DRT_creative: the pool-hall photograph (Module 1 report) recreated with the distributed ray tracer.
# Same calibrated camera and the same geometry as WSRT_creative (include/poolhall_geometry.pbrt),
# so the two integrators can be compared directly; materials: energy-conserving Phong BRDF.
#
# Effects to point out in the report:
#  - triangle meshes (OBJ)        : glass + water (lathe meshes with vertex normals), faceted crystal
#                                   cap, grater sleeve, four-part cue; normals and UVs from the files
#  - textures on meshes           : cue wood grain follows the mesh UVs; felt weave; speckled rail
#  - area light + soft shadows    : the key light is a disc of radius 3 (16 random shadow rays per
#                                   shading point): penumbrae instead of WSRT_creative's hard edges
#  - Phong BRDF                   : glossy balls, cue and rack (kd + ks + kr <= 1)
#  - depth of field (thin lens)   : focused on the glass of water (23.4 units); the far end of the
#                                   table and the hall blur, like the photograph
#  - Reinhard tone mapping        : on luminance, exposure 1.6, white point 4
LookAt 0 9.2 0   0 6.027 9.4832   0 1 0
Camera "perspective" "float fov" [ 46.2 ] "float lensradius" [ 0.25 ] "float focaldistance" [ 23.4 ]
Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 800 ]
    "string filename" [ "DRT_creative.png" ]
    "string tonemap" "reinhard" "string tonemapmode" "luminance" "float exposure" [ 1.6 ] "float whitepoint" [ 4.0 ]
Sampler "independent" "integer pixelsamples" [ 64 ]
Integrator "distributed" "integer maxdepth" [ 6 ] "integer lightsamples" [ 16 ]

WorldBegin

# Key light: a disc of radius 3 high above the far side of the table, facing it
# (same position and intensity as the WSRT key point light: L * area = 24000).
AttributeBegin
  Translate 6 45 72  Rotate 135.454 0.99388 -0.11043 0
  AreaLightSource "diffuse" "rgb L" [ 849 849 849 ] "integer samples" [ 16 ]
  Shape "disk" "float radius" [ 3 ]
AttributeEnd
# Fill light: weaker, warm (3000 K), from the right.
LightSource "point" "point3 from" [ 55 14 30 ] "blackbody I" [ 3000 ] "float scale" [ 2600 ]

Include "include/poolhall_materials_drt.pbrt"
Include "include/poolhall_spots_drt.pbrt"
Include "include/poolhall_geometry.pbrt"
