# Module 2, 2.2.1: perspective projection of a railway running to the horizon: the rails meet
# at a vanishing point and the poles shrink with distance, which conveys depth.
LookAt 4.5 2.2 -5   -1.5 1.4 30   0 1 0
Camera "perspective" "float fov" [ 45 ]
Film "rgb" "integer xresolution" [ 800 ] "integer yresolution" [ 600 ]
    "string filename" [ "camera_persp.png" ]
Sampler "stratified" "integer xsamples" [ 3 ] "integer ysamples" [ 3 ] "bool jitter" true
Integrator "whitted" "integer maxdepth" [ 2 ] "rgb ambient" [ 0.12 0.12 0.14 ]

Include "include/m2_railway.pbrt"
