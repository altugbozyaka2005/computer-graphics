# Module 2, 2.2.2: aliasing in the DRT. One camera ray per pixel centre, but 32 indirect rays per
# bounce: the shading is smooth, the geometry and texture edges still alias.
LookAt 0 1.3 -3   0 1.2 10   0 1 0
Camera "perspective" "float fov" [ 48 ]
Film "rgb" "integer xresolution" [ 800 ] "integer yresolution" [ 600 ]
    "string filename" [ "aa_drt.png" ] "string tonemap" "reinhard" "float whitepoint" [ 3 ]
Sampler "independent" "integer pixelsamples" [ 1 ]
Integrator "distributed" "integer maxdepth" [ 2 ] "integer branchingfactor" [ 32 ] "integer lightsamples" [ 1 ]

Include "include/m2_garden.pbrt"
