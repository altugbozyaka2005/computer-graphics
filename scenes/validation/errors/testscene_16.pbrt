# testscene_16 (see README.txt)
LookAt 0 3 -8  0 1 0  0 1 0
Camera "perspective" "float fov" [ 45 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 48 ] "string filename" [ "testsuite_my_16.pfm" ]
Sampler "independent" "integer pixelsamples" [ 4 ]
PixelFilter "box"
Integrator "path" "integer maxdepth" [ 1 ]
WorldBegin
LightSource "point" "point3 from" [ 0 4 -2 ] "rgb I" [ 10 10 10 ]
Material "diffuse" "rgb reflectance" [ 0.5 0.5 0.5 ]
AttributeEnd
Shape "sphere"
