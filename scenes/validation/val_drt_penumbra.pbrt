# DRT validation: noise of the area-light estimator against the number of shadow rays (report 3.3).
# DRT_simple's view of the torus shadow (crop window), with everything else that adds noise
# switched off: pinhole camera (lensradius 0), 1 sample per pixel at the pixel centre, and
# maxdepth 1 (direct light only). The only random choice left is the point sampled on the
# light, so the per-pixel standard deviation should fall as 1 / sqrt(lightsamples).
# renderReportedImages.sh renders it with --lightsamples 1, 4, 16, 64 and two seeds each;
# validate_module1.py estimates sigma from the difference of the two independent renders.
LookAt 0 2 -7.5   0 1.4 0   0 1 0
Camera "perspective" "float fov" [ 42 ]
Film "rgb" "integer xresolution" [ 1200 ] "integer yresolution" [ 900 ]
    "float cropwindow" [ 0.19 0.52 0.675 0.78 ]
    "string filename" [ "val_drt_penumbra.png" ]
    "string tonemap" "reinhard" "string tonemapmode" "luminance" "float whitepoint" [ 1.6 ]
Sampler "independent" "integer pixelsamples" [ 1 ]
Integrator "distributed" "integer maxdepth" [ 1 ] "integer lightsamples" [ 4 ]

Include "include/drt_simple_world.pbrt"
