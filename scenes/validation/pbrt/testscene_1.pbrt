# testscene_1 (see README.txt)
LookAt 0 3 -8  0 1 0  0 1 0
Camera "perspective" "float fov" [ 45 ]
Film "rgb" "integer xresolution" [ 160 ] "integer yresolution" [ 120 ] "string filename" [ "testsuite_my_1.pfm" ]
Sampler "independent" "integer pixelsamples" [ 64 ]
PixelFilter "box"
Integrator "path" "integer maxdepth" [ 1 ]
WorldBegin
LightSource "distant" "point3 from" [ 0 3 -8 ] "point3 to" [ 0 1 0 ] "rgb L" [ 3 3 3 ]
Material "diffuse" "rgb reflectance" [ 0.8 0.8 0.8 ]
AttributeBegin Translate -1.2 1 0 Shape "sphere" "float radius" [ 1 ] AttributeEnd
Shape "trianglemesh" "point3 P" [ 0.8 0 1  2.8 0 1  1.8 2.4 1 ]
