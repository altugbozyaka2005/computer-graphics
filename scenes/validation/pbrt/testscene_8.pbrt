# testscene_8 (see README.txt)
LookAt 0 3 -8  0 1 0  0 1 0
Camera "perspective" "float fov" [ 40 ]
Film "rgb" "integer xresolution" [ 96 ] "integer yresolution" [ 72 ] "string filename" [ "testsuite_my_8.pfm" ]
Sampler "independent" "integer pixelsamples" [ 256 ]
PixelFilter "box"
Integrator "path" "integer maxdepth" [ 8 ]
WorldBegin
LightSource "point" "point3 from" [ 2 5 -3 ] "rgb I" [ 30 30 30 ]
LightSource "infinite" "rgb L" [ 0.2 0.25 0.3 ]
Material "diffuse" "rgb reflectance" [ 0.5 0.5 0.5 ]
Shape "trianglemesh" "point3 P" [ -20 0 -20  20 0 -20  20 0 20  -20 0 20 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeBegin Translate 0 1 0 Material "dielectric" "float eta" [ 1.5 ] Shape "sphere" "float radius" [ 1 ] AttributeEnd
