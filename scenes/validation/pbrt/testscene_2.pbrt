# testscene_2 (see README.txt)
LookAt 0 0 -10  0 0 0  0 1 0
Camera "perspective" "float fov" [ 30 ]
Film "rgb" "integer xresolution" [ 192 ] "integer yresolution" [ 108 ] "string filename" [ "testsuite_my_2.pfm" ]
Sampler "independent" "integer pixelsamples" [ 64 ]
PixelFilter "box"
Integrator "path" "integer maxdepth" [ 1 ]
WorldBegin
LightSource "distant" "point3 from" [ 0 0 -10 ] "point3 to" [ 0 0 0 ] "rgb L" [ 3 3 3 ]
Material "diffuse" "rgb reflectance" [ 0.8 0.8 0.8 ]
AttributeBegin Translate -4 -2.2 0 Shape "sphere" "float radius" [ 0.25 ] AttributeEnd
AttributeBegin Translate -4 0 0 Shape "sphere" "float radius" [ 0.25 ] AttributeEnd
AttributeBegin Translate -4 2.2 0 Shape "sphere" "float radius" [ 0.25 ] AttributeEnd
AttributeBegin Translate 0 -2.2 0 Shape "sphere" "float radius" [ 0.25 ] AttributeEnd
AttributeBegin Translate 0 0 0 Shape "sphere" "float radius" [ 0.25 ] AttributeEnd
AttributeBegin Translate 0 2.2 0 Shape "sphere" "float radius" [ 0.25 ] AttributeEnd
AttributeBegin Translate 4 -2.2 0 Shape "sphere" "float radius" [ 0.25 ] AttributeEnd
AttributeBegin Translate 4 0 0 Shape "sphere" "float radius" [ 0.25 ] AttributeEnd
AttributeBegin Translate 4 2.2 0 Shape "sphere" "float radius" [ 0.25 ] AttributeEnd
