# testscene_5 (see README.txt)
LookAt 0 3 -8  0 1 0  0 1 0
Camera "perspective" "float fov" [ 50 ]
Film "rgb" "integer xresolution" [ 96 ] "integer yresolution" [ 72 ] "string filename" [ "testsuite_my_5.pfm" ]
Sampler "independent" "integer pixelsamples" [ 64 ]
PixelFilter "box"
Integrator "path" "integer maxdepth" [ 1 ]
WorldBegin
LightSource "point" "point3 from" [ 0 3 0 ] "rgb I" [ 20 20 20 ]
Material "diffuse" "rgb reflectance" [ 0.6 0.5 0.4 ]
Shape "trianglemesh" "point3 P" [ -20 0 -20  20 0 -20  20 0 20  -20 0 20 ] "integer indices" [ 0 1 2 0 2 3 ]
