# testscene_6 (see README.txt)
LookAt 0 3 -8  0 1 0  0 1 0
Camera "perspective" "float fov" [ 45 ]
Film "rgb" "integer xresolution" [ 96 ] "integer yresolution" [ 72 ] "string filename" [ "testsuite_my_6.pfm" ]
Sampler "independent" "integer pixelsamples" [ 256 ]
PixelFilter "box"
Integrator "path" "integer maxdepth" [ 1 ]
WorldBegin
AttributeBegin AreaLightSource "diffuse" "rgb L" [ 6 6 6 ]
  Shape "trianglemesh" "point3 P" [ -1 3 -1  1 3 -1  1 3 1  -1 3 1 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
AttributeBegin Translate 0 0.8 0 Shape "sphere" "float radius" [ 0.8 ] AttributeEnd
Shape "trianglemesh" "point3 P" [ -20 0 -20  20 0 -20  20 0 20  -20 0 20 ] "integer indices" [ 0 1 2 0 2 3 ]
