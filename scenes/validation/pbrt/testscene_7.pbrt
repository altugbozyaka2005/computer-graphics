# testscene_7 (see README.txt)
LookAt 0 1 -3.2  0 1 0  0 1 0
Camera "perspective" "float fov" [ 50 ]
Film "rgb" "integer xresolution" [ 80 ] "integer yresolution" [ 80 ] "string filename" [ "testsuite_my_7.pfm" ]
Sampler "independent" "integer pixelsamples" [ 1024 ]
PixelFilter "box"
Integrator "path" "integer maxdepth" [ 5 ]
WorldBegin
AttributeBegin AreaLightSource "diffuse" "rgb L" [ 8 8 8 ]
  Shape "trianglemesh" "point3 P" [ -0.3 1.99 -0.3  0.3 1.99 -0.3  0.3 1.99 0.3  -0.3 1.99 0.3 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
Shape "trianglemesh" "point3 P" [ -1 0 -4  1 0 -4  1 0 1  -1 0 1 ] "integer indices" [ 0 1 2 0 2 3 ]
Shape "trianglemesh" "point3 P" [ -1 2 -4  1 2 -4  1 2 1  -1 2 1 ] "integer indices" [ 0 1 2 0 2 3 ]
Shape "trianglemesh" "point3 P" [ -1 0 1  1 0 1  1 2 1  -1 2 1 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeBegin Material "diffuse" "rgb reflectance" [ 0.7 0.1 0.1 ]
  Shape "trianglemesh" "point3 P" [ -1 0 -4  -1 0 1  -1 2 1  -1 2 -4 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
AttributeBegin Material "diffuse" "rgb reflectance" [ 0.1 0.6 0.1 ]
  Shape "trianglemesh" "point3 P" [ 1 0 -4  1 0 1  1 2 1  1 2 -4 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
