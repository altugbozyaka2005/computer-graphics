# Module 3, 2.3.1 best case, "Phyllotaxis": 145004 primitives (25,000 marbles on a golden-angle spiral,
# a 120,000-triangle torus knot), small and spread out, so a ray's path through the BVH only
# reaches the few leaves near it. Timing: scenes/tools/module3_study.py (--accel bvh / objects / none).
LookAt 0 9.5 -16.5   0 1.6 0.5   0 1 0
Camera "perspective" "float fov" [ 34 ]
Film "rgb" "integer xresolution" [ 1920 ] "integer yresolution" [ 1080 ]
    "string filename" [ "acc_best.png" ]
Sampler "stratified" "integer xsamples" [ 3 ] "integer ysamples" [ 3 ] "bool jitter" true
Integrator "whitted" "integer maxdepth" [ 5 ] "rgb ambient" [ 0.06 0.06 0.07 ]
Accelerator "bvh" "string splitmethod" "sah" "integer maxnodeprims" [ 4 ]

Include "include/m3_best.pbrt"
