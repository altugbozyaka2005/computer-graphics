# WSRT_creative: the pool-hall photograph (Module 1 report) recreated with the Whitted ray tracer.
# Camera calibrated to the photograph (fov, height and pitch fitted to the eight ball sizes);
# all object positions back-projected from the photograph (see scenes/tools/make_poolroom.py).
#
# Effects to point out in the report:
#  - mirror reflection (recursive)  : steel grater reflects the felt, balls and perfume bottle
#  - refraction, Fresnel           : water glass (eta 1.5 / water 1.33): the yellow and black balls
#                                     behind it appear magnified and swapped left-to-right; crystal cap
#                                     (eta 1.55) with diagonal cut facets; ribbed rim: zig-zag waterline
#  - coloured transparent shadow    : amber bottle (filtered shadow rays: Fresnel x Kt per interface)
#  - light through the grater holes : alpha cut-outs, dots of light inside the grater's shadow
#  - hard shadows, two lights       : cool-white key (behind, high) and warm 3000 K fill (right)
#  - Blinn-Phong                    : small, strong highlights on every ball and on the metal
#  - textures                       : felt weave and speckled rail (triangles), wooden floor (plane),
#                                     cue wood, label
#  - geometry                       : plane (floor), spheres (balls), triangles (everything else);
#                                     the rack is three instances of one bar (ObjectInstance)
LookAt 0 9.2 0   0 6.027 9.4832   0 1 0
Camera "perspective" "float fov" [ 46.2 ]
Film "rgb" "integer xresolution" [ 1200 ] "integer yresolution" [ 1600 ]
    "string filename" [ "WSRT_creative.png" ]
Sampler "independent" "integer pixelsamples" [ 16 ]
Integrator "whitted" "integer maxdepth" [ 12 ] "rgb ambient" [ 1 1 1 ] "bool transparentshadows" true

WorldBegin

# Key light: bright neutral white, high above the far side of the table (top-middle of the frame);
# its shadows fall towards the camera and slightly left.
LightSource "point" "point3 from" [ 6 45 72 ] "rgb I" [ 24000 24000 24000 ]
# Fill light: weaker, warm (3000 K), from the right; second, fainter shadows fall to the left.
LightSource "point" "point3 from" [ 55 14 30 ] "blackbody I" [ 3000 ] "float scale" [ 2600 ]

Include "include/poolhall_materials_wsrt.pbrt"
Include "include/poolhall_spots_wsrt.pbrt"
Include "include/poolhall_geometry.pbrt"
