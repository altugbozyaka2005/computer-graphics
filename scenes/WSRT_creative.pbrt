# WSRT_creative: the pool-hall photograph (Module 1 report) recreated with the Whitted ray tracer.
# Geometry and materials: include/poolroom_world.pbrt (shared with DRT_creative.pbrt).
#
# Features to point out in the report:
#  - recursive mirror reflection : steel grater (Kr 0.5) reflects the perfume bottle and balls;
#                                  small clear-coat reflections on every ball
#  - refraction + Fresnel + TIR  : glass of water (inverts the yellow/black balls behind it),
#                                  perfume bottle (crystal cap + amber liquid, tinted Kt)
#  - Blinn-Phong                 : highlights on the balls, cue and frame; ambient fill in shadows
#  - point lights                : key light behind-right (shadows fall towards the camera, as in
#                                  the photo) + front-left fill; emitters (windows, TV, spots)
#                                  act as point lights at their centre in the WSRT
#  - shadows                     : hard shadows of balls, glass, bottle and grater on the felt
#  - textures (UV)               : spotted cue ball (sphere), felt (triangles), floor (plane),
#                                  grater holes, perfume label, sparkly frame, cue wood
#  - geometry                    : planes (floor), spheres (balls), triangles (everything else)
LookAt -3.5 8.5 -18   1.2 0.8 4   0 1 0
Camera "perspective" "float fov" [ 46 ]
Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 800 ]
    "string filename" [ "WSRT_creative.png" ]
Sampler "independent" "integer pixelsamples" [ 16 ]
Integrator "whitted" "integer maxdepth" [ 12 ] "rgb ambient" [ 1 1 1 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.03 0.03 0.035 ]
# Key light: bright, behind and to the right of the objects (windows side of the hall)
LightSource "point" "point3 from" [ 16 30 32 ] "rgb I" [ 2600 2500 2350 ]
# Fill light from the front left (camera side)
LightSource "point" "point3 from" [ -22 14 -26 ] "rgb I" [ 250 255 270 ]

Include "include/poolroom_world.pbrt"
