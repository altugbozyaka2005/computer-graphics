# testscene_5: Off-centre screen window on a perspective camera (shifted lens)
# Category: camera. As test 3 with 'screenwindow' [-1.1 1.9 -0.45 1.55] on a perspective camera: the view is shifted up and to the right like a shift lens. Checks that the screen window is mapped onto the raster exactly.
# Reference: testsuite_ref_5.pfm, rendered by pbrt-v4 from testscene_5_pbrt.pbrt (same scene; only Integrator, Sampler and Film differ).
# pbrt-v4 version of testscene_5.pbrt, used to render the reference image.
LookAt 0 0 0  0 0 1  0 1 0
Camera "perspective" "float fov" [ 40 ] "float screenwindow" [ -1.1 1.9 -0.45 1.55 ]
Film "rgb" "integer xresolution" [ 240 ] "integer yresolution" [ 160 ] "string filename" [ "testsuite_ref_5.pfm" ]
Sampler "stratified" "integer xsamples" [ 32 ] "integer ysamples" [ 32 ] "bool jitter" true
PixelFilter "box"
Integrator "path" "integer maxdepth" [ 1 ]

WorldBegin
AttributeBegin
Translate -3.4577 5.2048 10
AreaLightSource "diffuse" "rgb L" [ 1.0624 0.4781 0.7235 ] "bool twosided" true
Material "diffuse" "rgb reflectance" [ 0 0 0 ]
Shape "sphere" "float radius" [ 0.12 ]
AttributeEnd
