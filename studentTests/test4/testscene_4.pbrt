# testscene_4: Field of view, portrait 1:2 (fov on the horizontal axis)
# Category: camera. As test 3 for a portrait image with fov 60, where the shorter axis, and so the fov, is horizontal.
# Reference: testsuite_ref_4.pfm, rendered by pbrt-v4 from testscene_4_pbrt.pbrt (same scene; only Integrator, Sampler and Film differ).
LookAt 0 0 0  0 0 1  0 1 0
Camera "perspective" "float fov" [ 60 ]
Film "rgb" "integer xresolution" [ 120 ] "integer yresolution" [ 240 ] "string filename" [ "testsuite_my_4.png" ]
Sampler "stratified" "integer xsamples" [ 8 ] "integer ysamples" [ 8 ] "bool jitter" true
PixelFilter "box"
Integrator "distributed" "integer maxdepth" [ 1 ]

