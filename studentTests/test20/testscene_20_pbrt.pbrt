# testscene_20: Triangle mesh index out of range
# Category: error (range). Deliberate error (range): triangle mesh index out of range. The renderer must not crash or hang, and must report the problem (a log line mentioning one of ['index', 'indices', 'range']).
# pbrt-v4 version (gives pbrt-v4's own message in testsuite_ref_20.log).
LookAt 0 2.4 -6  0 0.7 0  0 1 0
Camera "perspective" "float fov" [ 40 ]
Film "rgb" "integer xresolution" [ 96 ] "integer yresolution" [ 72 ] "string filename" [ "testsuite_ref_20.png" ]
Sampler "independent" "integer pixelsamples" [ 8 ]
Integrator "path" "integer maxdepth" [ 2 ]
WorldBegin
LightSource "point" "point3 from" [ -2 5 -3 ] "rgb I" [ 30 28 24 ]
LightSource "distant" "point3 from" [ 3 4 -2 ] "point3 to" [ 0 0 0 ] "rgb L" [ 0.4 0.45 0.6 ]
Material "diffuse" "rgb reflectance" [ 0.55 0.5 0.45 ]
Shape "trianglemesh" "point3 P" [ -20 0 -20  20 0 -20  20 0 20  -20 0 20 ]
    "integer indices" [ 0 1 2 0 2 3 ]
AttributeBegin
Material "diffuse" "rgb reflectance" [ 0.7 0.25 0.15 ]
Translate -1.1 0.7 0.3
Shape "sphere" "float radius" [ 0.7 ]
AttributeEnd
AttributeBegin
Material "diffuse" "rgb reflectance" [ 0.15 0.4 0.65 ]
Translate 0.9 0.5 -0.2
Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd
Shape "trianglemesh" "point3 P" [ 0 0 0  1 0 0  0 1 0 ] "integer indices" [ 0 1 7 ]
